# Telegram 机器人 token（找 @BotFather 创建）
BOT_TOKEN=

# 作者 Telegram 数字 ID（唯一超级管理员；可再「授权」其他人）
# 获取方式：私聊 @userinfobot
AUTHOR_ID=

# trxfee.io API 凭据（在 trxfee.io 的 API 页面创建，成对使用）
TRXFEE_API_KEY=
TRXFEE_API_SECRET=

# trxfee.io API 基础地址（一般无需修改）
TRXFEE_BASE_URL=https://trxfee.io/v1

# 充值地址（「余额」指令展示用；接口返回地址不准时在此固定配置）
RECHARGE_ADDR=
